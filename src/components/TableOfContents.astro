---
import TableOfContentsHeading from "./TableOfContentsHeading.astro";

// https://kld.dev/building-table-of-contents/
const { headings } = Astro.props;

export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

export interface TocHeading extends Heading {
  subheadings: TocHeading[];
}

/**
 * Build a nested table of contents from the flat list of markdown headings.
 *
 * The previous implementation assumed every heading was either a depth-2 root
 * or had a shallower heading immediately before it, so a stray `# heading` or a
 * skipped level (e.g. `##` -> `####`) in a post made `parentHeadings.get(...)`
 * return `undefined` and crashed the build with
 * "Cannot read properties of undefined (reading 'subheadings')".
 *
 * We now keep a stack of open ancestors and attach each heading to the nearest
 * one that is shallower, so any heading order is safe.
 */
function buildToc(headings: Heading[]): TocHeading[] {
  const toc: TocHeading[] = [];
  const ancestors: TocHeading[] = [];

  for (const heading of headings) {
    const node: TocHeading = { ...heading, subheadings: [] };

    if (node.depth <= 2) {
      toc.push(node);
      ancestors.length = 0;
      ancestors.push(node);
      continue;
    }

    while (ancestors.length > 0 && ancestors[ancestors.length - 1].depth >= node.depth) {
      ancestors.pop();
    }

    const parent = ancestors[ancestors.length - 1];
    if (parent) {
      parent.subheadings.push(node);
    } else {
      // Orphan heading: the post jumps straight to ### (or deeper) with no parent.
      toc.push(node);
    }
    ancestors.push(node);
  }

  return toc;
}

const toc = buildToc(headings);
---

<details
  open
  class="animate rounded-lg border border-black/15 dark:border-white/20"
>
  <summary>目录</summary>
  <nav class="">
    <ul class="py-3">
      {toc.map((heading) => <TableOfContentsHeading heading={heading} />)}
    </ul>
  </nav>
</details>

<style>
  summary {
    @apply cursor-pointer rounded-t-lg px-3 py-1.5 font-medium transition-colors;
  }

  summary:hover {
    @apply bg-black/5 dark:bg-white/5;
  }

  details[open] summary {
    @apply bg-black/5 dark:bg-white/5;
  }
</style>
